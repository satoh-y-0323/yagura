{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "yagura",
  "version": "0.1.0",
  "identifier": "io.github.satoh-y-0323.yagura",
  "build": {
    "beforeBuildCommand": "npm run type-check && node scripts/prepare-sidecar.mjs",
    "beforeDevCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yagura",
        "label": "main",
        "url": "index.html",
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "width": 1200,
        "height": 600
      }
    ],
    "security": {
      "csp": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; default-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "The yagura Authors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yagura-daemon", "binaries/yagura-mcp"]
  }
}

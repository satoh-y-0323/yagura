{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "yagura",
  "version": "0.3.0",
  "identifier": "io.github.satoh-y-0323.yagura",
  "build": {
    "beforeBuildCommand": "npm run type-check && node scripts/prepare-sidecar.mjs",
    "beforeDevCommand": { "script": "node scripts/prepare-dev.mjs", "wait": true },
    "beforeBundleCommand": "node scripts/refuse-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yagura",
        "label": "main",
        "url": "index.html",
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "width": 1200,
        "height": 600
      }
    ],
    "security": {
      "csp": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; default-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "The yagura Authors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.50)"]
      }
    }
  }
}

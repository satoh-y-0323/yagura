{
  "name": "yagura-gui",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build:web && npm run build:tauri",
    "build:web": "vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tauri-apps/cli": "~2.11",
    "eslint": "^9",
    "eslint-plugin-svelte": "^3",
    "globals": "^17",
    "prettier": "^3.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.4",
    "typescript-eslint": "^8",
    "vite": "^8.2.4",
    "vitest": "^4.1"
  }
}

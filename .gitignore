gui/node_modules/
gui/dist/
gui/.pnpm-store/

# TypeScript
*.tsbuildinfo

# Python bytecode cache (scripts/ tooling and its pytest runs)
__pycache__/

# Claude Code project-scoped MCP registration (points at a local build)
.mcp.json

